# ==============================================================================
# CSV INSIGHT AI - Environment Configuration Example
# Copy this file to '.env' and provide your actual API keys.
# DO NOT commit '.env' to version control!
# ==============================================================================

# Google Gemini API Key (Required for LLM Data Assistant, Vision, and Prompting)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Hugging Face Token (if accessing gated models)
HF_TOKEN=your_huggingface_token_here

# Application Configuration
APP_ENV=development
DEBUG=True
MAX_UPLOAD_SIZE_MB=15
CTGAN_DEFAULT_EPOCHS=20
